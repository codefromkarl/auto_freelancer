# Runtime Configuration
TIMEZONE=Asia/Shanghai

# Freelancer API
FREELANCER_APP_ID=
FREELANCER_APP_SECRET=
FREELANCER_OAUTH_TOKEN=
FREELANCER_USER_ID=

# AI Configuration (Zhipu AI / GLM-4)
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/coding/paas/v4/chat/completions

# LLM Configuration (for AI scoring)
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# All scoring entry points use this mode; single invokes one configured model.
LLM_SCORING_MODE=single
# Scores older than this many hours return to evaluation.
SCORING_TTL_HOURS=6

# Proposal generation length strategy (character-based)
PROPOSAL_MIN_LENGTH=280
PROPOSAL_MAX_LENGTH=1800
PROPOSAL_TARGET_CHAR_MIN=700
PROPOSAL_TARGET_CHAR_MAX=1200
# Competitor context freshness; expiry also bounds the prepared approval lifetime.
PROPOSAL_COMPETITOR_CONTEXT_TTL_SECONDS=1800

# Bid selection profile
# newcomer: prioritize easier first wins (small/medium clear projects)
# balanced: use balanced scope preferences; no post-scoring bonus
BID_SELECTION_PROFILE=newcomer
MIN_BUDGET_THRESHOLD=5

# Python Service Security
PYTHON_API_KEY=replace_with_secure_random_key
# Allowed frontend origins (JSON array); defaults to local port 3000.
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Legacy AI Placeholders (Optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ENABLED=false

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=true
DEEPSEEK_MODEL=deepseek-chat

# Database Configuration
# DATABASE_PATH and LOG_FILE default to project-local paths; override only if needed.

# QQ Bot official API (private credentials may be stored in ignored .env.qqbot)
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_API_BASE=https://api.bot.qq.com
QQ_BOT_TARGET_TYPE=c2c
QQ_BOT_TARGET_ID=
QQ_BOT_APPROVER_OPENIDS=
# Optional separate approval/notification store
# QQ_BOT_STATE_PATH=/absolute/project/path/python_service/data/qqbot.db

# Independent real-bid switch remains off; QQ approval alone never enables it.
BID_SUBMISSION_ENABLED=false
BID_MAX_DAILY_ATTEMPTS=1
# Set BID_MAX_DAILY_ATTEMPTS=0 for no local daily cap; platform quotas still apply.
BID_MAX_DAILY_SCORED_PROJECTS=20
BID_MAX_CANDIDATE_PREPARATIONS_PER_CYCLE=10
BID_MAX_AMOUNT_USD=1000
BID_MIN_NET_HOURLY_USD=15
BID_MAX_ESTIMATED_HOURS=40

# User Skills for Project Matching
# Skills extracted from resume for project relevance scoring
USER_SKILLS=fastapi,spring,spring-cloud,spring-boot,oauth,rbac,microservices,service-discovery,api-gateway,config-center,service-governance,langchain,rag,vector-database,llm,prompt-engineering,mysql,sqlite,mybatis,docker,docker-compose,ffmpeg,video-processing,subtitle-rendering,ci-cd,code-standards,unit-testing
